@base = http://localhost:3000/api/v1/products

### 1. Consulta general (solo activos)
GET {{base}}/getAll?active=TRUE

### 2. Consulta por ID
GET {{base}}/getById/1

### 3. Crear producto
POST {{base}}/create
Content-Type: application/json

{
  "name": "Mouse",
  "price": 350.00,
  "stock": 20,
  "description": "Mouse inalámbrico",
  "brand": "Logitech",
  "img": "mouse.jpg"
}

### 4. Actualización completa (cambia el 2 por el ID creado)
PUT {{base}}/update/2
Content-Type: application/json

{
  "name": "Mouse Pro",
  "price": 420.00,
  "stock": 15,
  "description": "Mouse inalámbrico ergonómico",
  "brand": "Logitech",
  "img": "mouse-pro.jpg"
}

### 5. Cambiar solo el precio
PATCH {{base}}/change-price/2
Content-Type: application/json

{
  "price": 399.99
}

### 6. Baja lógica
DELETE {{base}}/delete/2

### 7. Verificar que ya no aparece
GET {{base}}/getAll?active=TRUE

###
GET {{base}}/getById/2

### 8. ID inexistente (debe dar 404)
GET {{base}}/getById/9999

### 9. Datos inválidos: precio negativo (debe dar 400)
POST {{base}}/create
Content-Type: application/json

{
  "name": "Prueba",
  "price": -5,
  "stock": 1,
  "description": "Precio inválido"
}
